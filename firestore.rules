rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { 
      return request.auth != null; 
    }
    
    function isOwnerOf(resource) { 
      return isAuthed() && resource.data.authorId == request.auth.uid; 
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'content', 'authorId', 'createdAt'])
        && !('upvoteCount' in request.resource.data)
        && !('commentCount' in request.resource.data)
        && !('moderationStatus' in request.resource.data);
      allow update: if isOwnerOf(resource)
        && !('upvoteCount' in request.resource.data)
        && !('commentCount' in request.resource.data)
        && !('moderationStatus' in request.resource.data)
        && !('authorId' in request.resource.data); // Prevent changing author
      allow delete: if isOwnerOf(resource);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwnerOf(resource)
        && (
          // Allow soft delete fields
          (request.resource.data.deleted == true 
            && request.resource.data.deletedBy == request.auth.uid
            && 'deletedAt' in request.resource.data)
          ||
          // Allow restore
          (request.resource.data.deleted == false
            && resource.data.deleted == true
            && resource.data.deletedBy == request.auth.uid)
          ||
          // Allow other updates (content)
          (!('deleted' in request.resource.data)
            && !('deletedBy' in request.resource.data)
            && !('deletedAt' in request.resource.data))
        );
      allow delete: if false; // Disable hard delete from client
    }

    match /postVotes/{voteId} {
      allow read: if true;
      allow create, update: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isAuthed() && request.resource.data.reporterId == request.auth.uid;
    }

    match /userPublicProfiles/{userId} {
      allow read: if true;
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    match /userStats/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Brain Training Collections
    match /brain_training_sessions/{sessionId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['gameType', 'userId', 'score', 'level', 'accuracy', 'duration', 'completedAt', 'details']);
      allow update, delete: if false; // Sessions are immutable once created
    }

    match /brain_training_progress/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow create: if isAuthed() 
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid; // Prevent changing userId
    }


    match /cognitive_assessments/{assessmentId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Assessments are immutable
    }
  }
}
