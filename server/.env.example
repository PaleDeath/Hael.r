# Copy this file to server/.env and fill in values.
# server/.env is gitignored — never commit real credentials.

PORT=5000
NODE_ENV=development

# Firebase Admin SDK — provide ONE of the following:
#
# Option A (recommended for production): JSON service account key as a single-line string
#   Generate at: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
#
# Option B (GCP / Cloud Run): leave blank; set GOOGLE_APPLICATION_CREDENTIALS to the key file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
#
# Option C (local dev only): just the project ID (works with Firebase Auth emulator)
FIREBASE_PROJECT_ID=haelr-462818

# CORS — allowed frontend origin(s)
CORS_ORIGIN=http://localhost:3000

# Admin Firebase UIDs (comma-separated) for privileged delete operations
ADMIN_USER_IDS=

# Optional: enable real OpenAI Moderation API for community content
USE_OPENAI_MODERATION=false
MODERATION_THRESHOLD=0.7
MODERATION_FLAG_THRESHOLD=0.5
